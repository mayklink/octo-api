NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/octob?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/octob?schema=public
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RABBITMQ_URL=amqp://octob:octob-local-only@localhost:5672
RABBITMQ_EXCHANGE=octob.reviews
RABBITMQ_INPUT_QUEUE=octob.review-worker.review.requested
RABBITMQ_RESULTS_QUEUE=octob.api.review-results
RABBITMQ_DLX=octob.reviews.dlx
OCTOB_DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
OCTOB_CREDENTIAL_KEY_LOCAL=REPLACE_WITH_32_BYTES_BASE64
# Fallback global de fábrica: usado apenas quando a organização não tem
# allowedModels/defaultModel próprios configurados (ver Organization no Prisma
# schema e OrganizationsService.resolveModelPolicy).
ALLOWED_CODEX_MODELS=gpt-5.6-luna
DEFAULT_CODEX_MODEL=gpt-5.6-luna
MAX_MESSAGE_BYTES=262144
REVIEW_TIMEOUT_MS=900000
MAX_REVIEW_ATTEMPTS=3
RETRY_BASE_DELAY_MS=30000
PUBLIC_API_URL=http://localhost:3000
AZURE_DEVOPS_API_VERSION=7.1
SEED_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
SEED_ORGANIZATION_NAME=Octob
SEED_USER_ID=00000000-0000-4000-8000-000000000002
